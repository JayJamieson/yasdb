{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "tags": [
    "yasdb",
    "slatedb",
    "durable-streams"
  ],
  "title": "yasdb \u2014 Durable Streams / SlateDB engine metrics",
  "uid": "yasdb-slatedb-metrics",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "name": "app",
        "type": "textbox",
        "label": "App",
        "query": "yasdb",
        "current": {
          "text": "yasdb",
          "value": "yasdb"
        },
        "options": [
          {
            "text": "yasdb",
            "value": "yasdb",
            "selected": true
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "type": "text",
      "title": "Durable Streams / SlateDB engine metrics",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Native SlateDB engine metrics (write path, LSM/compaction health, object store, cache, GC), exposed by yasdb's `/metrics` endpoint (see `-metrics-addr` / `YASDB_METRICS_ADDR`, `fly.toml`'s `[metrics]` block) and scraped by Fly's platform. Alongside `yasdb_append_requests_total`/`yasdb_append_records_total` (yasdb's own request-level counters \u2014 see the \"Application throughput\" panel below), this is otherwise engine instrumentation, not HTTP request metrics \u2014 pair with the Fly built-in `fly_instance_*` dashboards (see `deploy/loadtest/grafana-dashboard.json`) for host-level CPU/disk/memory."
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "At a glance",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "stat",
      "title": "L0 SSTs (unmerged)",
      "description": "Level-0 SST count. Climbing toward segment_max_l0_sst_count means compaction is falling behind writes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 4
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "slatedb_db_l0_sst_count{app=\"$app\"}",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Backpressure events (5m rate)",
      "description": "Writes throttled because the engine is behind on flush/compaction. Should be ~0 in steady state.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(slatedb_db_backpressure_count{app=\"$app\"}[5m]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Running compactions",
      "description": "How many compaction jobs are active right now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(slatedb_compactor_running_compactions{app=\"$app\"})",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Block cache hit rate",
      "description": "Fraction of block-cache lookups (data/index/filter/stats blocks) served from memory rather than the object store.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(slatedb_db_cache_access_count{app=\"$app\",result=\"hit\"}[5m])) / sum(rate(slatedb_db_cache_access_count{app=\"$app\"}[5m]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Write path",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Write ops / batches (rate)",
      "description": "Individual writes vs the WriteBatches they were grouped into \u2014 a low ratio means good group-commit batching.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(slatedb_db_write_ops{app=\"$app\"}[1m]))",
          "legendFormat": "write ops/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(slatedb_db_write_batch_count{app=\"$app\"}[1m]))",
          "legendFormat": "write batches/s"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "DB request rate by op",
      "description": "get / scan / flush calls against the engine, from all paths (streamer + reads).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (op) (rate(slatedb_db_request_count{app=\"$app\"}[1m]))",
          "legendFormat": "{{op}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "WAL flush throughput",
      "description": "Bytes durably flushed to the WAL vs. bytes written into the memtable \u2014 sustained gap between them means the WAL is the bottleneck.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(slatedb_wal_wal_flush_bytes{app=\"$app\"}[1m]))",
          "legendFormat": "WAL flush B/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(slatedb_db_memtable_write_bytes{app=\"$app\"}[1m]))",
          "legendFormat": "memtable write B/s"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "WAL buffer backlog",
      "description": "Bytes accepted but not yet flushed. Should track -flush cadence, not grow unbounded.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "slatedb_db_wal_buffer_estimated_bytes{app=\"$app\"}",
          "legendFormat": "estimated bytes buffered"
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "LSM / compaction health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "L0 SST count vs. stall threshold",
      "description": "Writes stall once L0 SSTs reach the threshold (see the L0 stall panel) \u2014 this is the leading indicator.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "slatedb_db_l0_sst_count{app=\"$app\"}",
          "legendFormat": "L0 SSTs"
