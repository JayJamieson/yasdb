    {
      "id": 18,
      "type": "timeseries",
      "title": "Seconds since last compaction",
      "description": "No data until the first compaction ever runs (the underlying gauge is 0 until then \u2014 subtracting from time() would otherwise show a nonsense multi-year age). A steadily climbing line with no writes is fine; climbing under sustained write load means compaction has stopped making progress.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(time() - slatedb_compactor_last_compaction_timestamp_sec{app=\"$app\"}) and (slatedb_compactor_last_compaction_timestamp_sec{app=\"$app\"} > 0)",
          "legendFormat": "age"
        }
      ]
    },
