          "expr": "sum by (type) (rate(slatedb_db_l0_stall_count{app=\"$app\"}[1m]))",
          "legendFormat": "stall: {{type}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(slatedb_db_backpressure_count{app=\"$app\"}[1m]))",
