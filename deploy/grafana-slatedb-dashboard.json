        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "slatedb_db_segment_max_l0_sst_count{app=\"$app\"}",
          "legendFormat": "stall threshold"
